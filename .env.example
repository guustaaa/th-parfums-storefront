# THPARFUMS — environment variables
# Copy to .env.local and fill in. With Supabase blank, the app runs on local
# seed data (great for a first look). Fill these to enable the DB + admin.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin (must match a Supabase Auth user).
ADMIN_EMAILS=voce@exemplo.com

# Store WhatsApp number with country + area code, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=5554920004118
