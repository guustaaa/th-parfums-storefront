# THPARFUMS — variáveis de ambiente
# Copie para .env.local e preencha os valores. Sem configurar o Supabase, a
# aplicação usa os dados locais. Preencha as chaves para habilitar banco e painel.

# Supabase (Configurações do projeto → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Uso exclusivo no servidor. Nunca exponha esta chave no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails autorizados no painel, separados por vírgula.
ADMIN_EMAILS=voce@exemplo.com

# WhatsApp da loja com país e DDD, usando somente números.
NEXT_PUBLIC_WHATSAPP_NUMBER=5554920004118
